# --- Diretórios (padrão funcionam, só altere se necessário) ---
# DATA_DIR=data
# OUTPUTS_DIR=outputs
# CACHE_DIR=cache
# LOGS_DIR=logs

# --- Whisper ---
# WHISPER_MODEL_SIZE=small
# WHISPER_DEVICE=cpu       # "cuda" ou "cpu"
# WHISPER_INITIAL_PROMPT=  # vocabulario esperado (hotwords); vazio = usa o glossario

# --- Glossario de vocabulario (D20) ---
# GLOSSARY_NAME=vampiro    # nome em glossaries/ (ex: vampiro, lobisomem, mago). Vazio = desativado
# HASHTAGS_FILE=hashtags_vampiro.md   # lista curada (D24), em glossaries/ ou caminho absoluto

# --- Contexto de campanha (D23) ---
# CAMPAIGN_CONTEXT_FILE=campanha/minha_cronica.md

# --- Conteudo (D22): sessao | mecanica | lore | podcast ---
# CONTENT_TYPE=sessao

# --- Marcadores de voz (D25) ---
# OOC_PAUSE_WORD=pausa
# OOC_RESUME_WORD=retomando

# --- Provedor LLM: ollama | gemini | groq ---
# LLM_PROVIDER=ollama

# --- Ollama (usado quando LLM_PROVIDER=ollama) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b

# --- Gemini (usado quando LLM_PROVIDER=gemini) ---
# GEMINI_API_KEY=suachaveaqui
# GEMINI_MODEL=gemini-2.5-flash

# --- Groq (usado quando LLM_PROVIDER=groq) ---
# GROQ_API_KEY=suachaveaqui
# GROQ_MODEL=llama-3.1-8b-instant

# --- Logging ---
# LOG_LEVEL=INFO

# --- Delay entre chamadas LLM (rate limit / Ollama local) ---
# LLM_CALL_DELAY_SECONDS=3.0

# --- Shorts ---
# SHORTS_TARGET_COUNT=4
# SHORTS_MIN_STANDALONE_SCORE=0.5   # abaixo disso o short e descartado (critico D19)
